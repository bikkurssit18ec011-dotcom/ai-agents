    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build the send list: validate, filter by priority, drop suppressed and\n// duplicates, then cap at the daily limit. Everything it rejects is logged\n// so a short send is never silent.\nconst cfg = $('Campaign Config').first().json;\nconst leads = $('Leads To Rows').all().map(i => i.json);\n\nconst suppressed = new Set(\n  $('Suppression To Rows').all()\n    .map(i => String(i.json.email || '').trim().toLowerCase())\n    .filter(Boolean)\n);\n\nconst allowed = String(cfg.priorityFilter || '')\n  .split(',').map(s => s.trim().toUpperCase()).filter(Boolean);\n\nconst EMAIL_RE = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/;\nconst seen = new Set();\nconst eligible = [];\nconst skipped = [];\n\nfor (const lead of leads) {\n  const email = String(lead.email || '').trim().toLowerCase();\n  const priority = String(lead.priority || '').trim().toUpperCase();\n  const skip = (reason) =>\n    skipped.push({ email: email || '(blank)', branch: lead.branch_name, reason });\n\n  if (!email)                                   { skip('no email address');        continue; }\n  if (!EMAIL_RE.test(email))                    { skip('malformed email');         continue; }\n  if (allowed.length && !allowed.includes(priority)) {\n                                                  skip(`priority ${priority} excluded`); continue; }\n  if (suppressed.has(email))                    { skip('on suppression list');     continue; }\n  if (seen.has(email))                          { skip('duplicate in CSV');        continue; }\n\n  seen.add(email);\n  eligible.push({ json: { ...lead, email } });\n}\n\nconst limit = Number(cfg.dailyLimit) > 0 ? Number(cfg.dailyLimit) : eligible.length;\nconst toSend = eligible.slice(0, limit);\n\nconsole.log(`[${cfg.campaignName}] leads=${leads.length} eligible=${eligible.length} ` +\n            `sending=${toSend.length} skipped=${skipped.length} dryRun=${cfg.dryRun}`);\nfor (const s of skipped) console.log(`  SKIP ${s.email} (${s.branch}) - ${s.reason}`);\nif (eligible.length > toSend.length) {\n  console.log(`  HELD ${eligible.length - toSend.length} lead(s) by dailyLimit=${limit}`);\n}\n\nreturn toSend;"
      },
