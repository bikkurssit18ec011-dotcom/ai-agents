    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Render one email: substitute {{placeholders}} in the HTML template and the\n// subject line, and derive a plain-text alternative for deliverability.\nconst cfg  = $('Campaign Config').first().json;\nconst tpl  = $('Template To Text').first().json.templateHtml;\nconst lead = $json;\n\nconst isRegionalOffice = /^R\\.?O\\.?/i.test(String(lead.branch_name || ''));\n\nconst vars = {\n  branch_name:       lead.branch_name  || 'your branch',\n  branch_code:       lead.branch_code  || '',\n  contact_name:      isRegionalOffice ? 'Sir/Madam' : 'Branch Manager',\n  locality:          String(lead.address || '').split(',')[0].trim()\n                       || lead.branch_name || 'your area',\n  region_office:     lead.region_office && lead.region_office !== '-'\n                       ? `the ${lead.region_office} Regional Office`\n                       : 'the Regional Office',\n  campaign:          cfg.campaignName,\n  sender_name:       cfg.fromName,\n  sender_email:      cfg.fromEmail,\n  deck_url:          cfg.deckUrl || '',\n  unsubscribe_email: cfg.fromEmail,\n};\n\nconst render = (s) =>\n  String(s == null ? '' : s)\n    .replace(/\\{\\{\\s*([a-z_]+)\\s*\\}\\}/gi, (m, k) => (k in vars ? vars[k] : m));\n\nconst html = render(tpl);\nconst subject = render(cfg.subjectTemplate);\n\n// Unresolved placeholders mean a template/CSV mismatch - fail loudly.\nconst leftover = html.match(/\\{\\{\\s*[a-z_]+\\s*\\}\\}/gi);\nif (leftover) {\n  throw new Error(`Unresolved placeholders for ${lead.email}: ${[...new Set(leftover)].join(', ')}`);\n}\n\nconst text = html\n  .replace(/<!--[\\s\\S]*?-->/g, '')\n  .replace(/<(style|script)[\\s\\S]*?<\\/\\1>/gi, '')\n  .replace(/<br\\s*\\/?>/gi, '\\n')\n  .replace(/<\\/(p|tr|div|h[1-6])>/gi, '\\n\\n')\n  .replace(/<[^>]+>/g, '')\n  .replace(/&mdash;/g, '-').replace(/&ldquo;|&rdquo;/g, '\"')\n  .replace(/&#8377;/g, 'INR ').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&')\n  .replace(/[ \\t]{2,}/g, ' ')\n  .replace(/\\n{3,}/g, '\\n\\n')\n  .trim();\n\nreturn {\n  json: {\n    branch_code: lead.branch_code,\n    branch_name: lead.branch_name,\n    priority:    lead.priority,\n    toEmail:     lead.email,\n    subject,\n    html,\n    text,\n  },\n};"
      },
